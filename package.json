{
  "name": "peridot-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "node electron/dev.mjs",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Peridot AI desktop app",
  "author": "Peridot",
  "main": "electron/main.mjs",
  "build": {
    "appId": "ai.peridot.desktop",
    "productName": "Peridot AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "icon": "public/logo.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "trustedDependencies": [
    "electron"
  ]
}
